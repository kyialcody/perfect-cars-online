# Скопируйте в .env и при необходимости поменяйте значения.
# .env в git не коммитится (см. .gitignore).

APP_ENV=dev

# PostgreSQL
POSTGRES_USER=cars
POSTGRES_PASSWORD=cars
POSTGRES_DB=cars
# Хост `db` — имя сервиса в docker-compose
DATABASE_URL=postgresql+asyncpg://cars:cars@db:5432/cars

# Redis
REDIS_URL=redis://redis:6379/0

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
# Браузеро-доступный адрес для ссылок на картинки (вне docker-сети)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cars

# CORS (через запятую). В проде (APP_ENV!=dev) обязателен реальный домен(ы)
# фронта — иначе приложение не стартует. Напр.:
# CORS_ORIGINS=https://perfect-cars.online,https://auto-america.online
CORS_ORIGINS=http://localhost:5173

# Анти-спам для заявок: лимит на IP в окне (секунды)
LEADS_RATE_LIMIT=5
LEADS_RATE_WINDOW=60
# Доверять X-Forwarded-For (только если стоите за доверенным прокси)
TRUST_PROXY=false

# Telegram-уведомления о заявках (необязательно — без значений не отправляются)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auth / JWT
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60
# Анти-спам для регистрации: аккаунтов на IP в окне (секунды)
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=60

# Админка (SQLAdmin) — /admin. При старте приложение создаёт/повышает админа
# с этими данными. Пустой пароль — пропустить создание. Пароль существующего
# админа не перезаписывается (меняйте в самой админке).
ADMIN_EMAIL=admin@cars-zeekr.local
ADMIN_PASSWORD=change-me-admin

# Frontend → API
VITE_API_URL=http://localhost:8000
