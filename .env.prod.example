# Прод-окружение для деплоя по IP (до подключения домена).
# Скопируйте на сервере в .env и подставьте реальные значения (TODO).
# .env в git не коммитится.

APP_ENV=prod

# PostgreSQL — ОБЯЗАТЕЛЬНО смените пароль
POSTGRES_USER=cars
POSTGRES_PASSWORD=CHANGE_ME_db_password   # TODO
POSTGRES_DB=cars
DATABASE_URL=postgresql+asyncpg://cars:CHANGE_ME_db_password@db:5432/cars   # TODO: тот же пароль

# Redis (внутри compose-сети)
REDIS_URL=redis://redis:6379/0

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
# Браузеро-доступный адрес картинок. Пока нет домена — IP сервера:
S3_PUBLIC_ENDPOINT=http://62.113.44.135:9000
S3_ACCESS_KEY=CHANGE_ME_s3_key           # TODO
S3_SECRET_KEY=CHANGE_ME_s3_secret        # TODO
S3_BUCKET=cars

# CORS — фронт ходит в API same-origin через /api, но в проде значение
# обязано быть не-localhost, иначе приложение не стартует. Указываем IP:
CORS_ORIGINS=http://62.113.44.135

# За nginx включаем доверие к X-Forwarded-For (nginx его перезаписывает),
# иначе rate-limit будет считать всех как один IP nginx.
TRUST_PROXY=true

# Telegram-уведомления о заявках (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ключ Яндекс.Карт (клиентский, вшивается в сборку фронта). Без него карта
# на странице «Контакты» заменяется статичной карточкой.
VITE_YANDEX_MAPS_API_KEY=

# Auth / JWT — сгенерируйте секрет: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_openssl_rand_hex_32   # TODO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=60

# Админка (SQLAdmin) — /api/admin. Смените пароль.
ADMIN_EMAIL=admin@cars-zeekr.local
ADMIN_PASSWORD=CHANGE_ME_admin_password   # TODO

# Бренд, вшиваемый в прод-сборку фронта, пока домены не различаются по hostname.
VITE_BRAND=perfect-cars
